// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
    "language_models": {
        "openai_compatible": {
            "omniroute": {
                "api_url": "https://remnabotvpn.mooo.com/v1",
                "available_models": [
                    {
                        "name": "kr/claude-sonnet-4.5",
                        "max_tokens": 200000,
                        "max_output_tokens": 32000,
                        "max_completion_tokens": 200000,
                        "capabilities": {
                            "tools": true,
                            "images": false,
                            "parallel_tool_calls": false,
                            "prompt_cache_key": false,
                            "chat_completions": true,
                            "interleaved_reasoning": false
                        }
                    }
                ]
            }
        }
    },
    "buffer_font_weight": 400.0,
    "terminal": {
        "font_size": 22.0
    },
    "cli_default_open_behavior": "new_window",
    "outline_panel": {
        "dock": "left"
    },
    "collaboration_panel": {
        "dock": "left"
    },
    "git_panel": {
        "dock": "left"
    },
    "icon_theme": "Material Icon Theme",
    "edit_predictions": {
        "provider": "zed",
        "mode": "subtle"
    },
    "auto_indent_on_paste": false,
    "format_on_save": "on",
    "formatter": "language_server",
    "code_actions_on_format": {
        "source.organizeImports.biome": true,
        "source.fixAll.biome": true,
    },
    "languages": {
        "JavaScript": {
            "formatter": {
                "language_server": {
                    "name": "biome"
                }
            }
        },
        "TypeScript": {
            "show_edit_predictions": true,
            "formatter": {
                "language_server": {
                    "name": "biome"
                }
            }
        },
        "TSX": {
            "show_edit_predictions": true,
            "formatter": {
                "language_server": {
                    "name": "biome"
                }
                }
        },
        "JSON": {
            "formatter": {
                "language_server": {
                    "name": "biome"
                }

            },
        },
        "JSONC": {
            "formatter": {
                "language_server": {
                    "name": "biome"
                }
            }
        },
        "CSS": {
            "formatter": {
                "language_server": {
                    "name": "biome"
                }
            }
        },
    },
    "tab_size": 4,
    "auto_indent": "syntax_aware",
    "hard_tabs": false,
    "agent": {
        "dock": "right",
        "tool_permissions": {
            "default": "allow"
        },
        "default_model": {
            "provider": "anthropic",
            "model": "claude-sonnet-4-5-latest"
        },
        "inline_assistant_model": {
            "provider": "anthropic",
            "model": "claude-sonnet-4-6-latest"
        },
        "model_parameters": [],
    },
    "diagnostics": {
        "inline": {
            "enabled": false,
        },
    },
    "inline_code_actions": true,
    "base_keymap": "VSCode",
    "autosave": "off",
    "project_panel": {
        "dock": "right",
    },
    "toolbar": {
        "breadcrumbs": false,
        "quick_actions": false,
        // "code_actions": true
    },
    "theme": "One Dark",
    "ui_font_family": "InconsolataGo Nerd Font Mono",
    "buffer_font_family": "InconsolataGo Nerd Font Mono",
    "vim_mode": true,
    "ui_font_size": 22.0,
    "buffer_font_size": 20.0,
    "cursor_blink": false,
    "show_edit_predictions": false,
    "relative_line_numbers": "disabled",
    "indent_guides": {
        "active_line_width": 4,
        "line_width": 4,
        // "enabled": false,
        "coloring": "indent_aware",
    },
    // "features": {
    // 	"edit_prediction_provider": "zed",
    // },
    "linked_edits": false,
    "hide_mouse": "on_typing_and_movement",
    "telemetry": {
        "metrics": false,
        "diagnostics": false,
    },
    "preview_tabs": {
        "enabled": false,
    },
    "scrollbar": {
        "show": "never"
    },
    "tabs": {
        "show_diagnostics": "all",
        "file_icons": true,
        "git_status": true,
    },
    "git": {
        "inline_blame": {
            "show_commit_summary": true,
        },
        "git_gutter": "tracked_files",
    },
    "lsp": {
        "vtsls": {
            "settings": {
                "typescript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always"
                    }
                },
                "javascript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always"
                    }
                }
            },
            "enable_lsp_tasks": true
        },
        "rust-analyzer": {
            "initialization_options": {
                "inlayHints": {
                    "maxLength": null,
                    "lifetimeElisionHints": {
                        "enable": "skip_trivial",
                        "useParameterNames": true,
                    },
                    "closureReturnTypeHints": {
                        "enable": "always",
                    },
                },
            },
        },
        "biome": {
            "binary": {
                "path": "/opt/homebrew/bin/biome",
                "arguments": [
                    "lsp-proxy"
                ]
            }
        }
    },
}
